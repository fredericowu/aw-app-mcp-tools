{
  "manifest_version": 1,
  "id": "mcp-tools",
  "name": "MCP Tools",
  "version": "0.15.0",
  "description": "A blank, configurable placeholder for workspace MCP upstreams.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "category": "Tools",
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "mcp_tools_app.plugin:McpToolsAppPlugin",
    "pip_requires": [],
    "standalone": {
      "module": "mcp_tools_app",
      "default_port": 9406
    }
  },
  "permissions": [
    "fs:workspace-data",
    "routes:register",
    "ui:code"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/mcp-tools"
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/mcp-tools.js",
      "slots": [
        "core.window.body:mcp-tools.settings"
      ]
    },
    "mcp": {
      "reload_on_save": true
    },
    "windows": [
      {
        "id": "mcp-tools.settings",
        "title": "MCP Tools",
        "body": {
          "type": "component"
        }
      }
    ],
    "settings_panels": [
      {
        "id": "mcp-tools.settings",
        "window": "mcp-tools.settings"
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "mcpServers": {
        "type": "object",
        "title": "MCP servers",
        "description": "Written verbatim to this app's mcp.json. Edit in Settings > Apps > MCP Tools (Servers or JSON); no servers are preconfigured.",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "title": "MCP server",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "stdio",
                "http",
                "gateway"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object"
            },
            "cwd": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "headers": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "http",
                      "gateway"
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            },
            {
              "if": {
                "not": {
                  "required": [
                    "type"
                  ]
                }
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "command"
                    ]
                  },
                  {
                    "required": [
                      "url"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "stdio"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "required": [
                  "command"
                ]
              }
            }
          ]
        }
      }
    },
    "required": []
  },
  "dependencies": {
    "apps": [
      {
        "id": "mcp-gateway",
        "version": ">=0.1.0",
        "required": true,
        "reason": "MCP Tools contributes mcp.json definitions that are discovered and merged by the MCP Gateway app."
      }
    ],
    "note": "Runtime-enforced app dependency: aw-workspace installs/loads mcp-gateway before mcp-tools so the gateway can scan mcp-tools/mcp.json."
  },
  "migrations": {}
}
